{
  "name": "daytona-x402",
  "version": "0.1.0",
  "description": "Pay-per-sandbox access to Daytona via the x402 protocol (HTTP 402, USDC). Standalone wrapper; not affiliated with Daytona.",
  "license": "MIT",
  "author": "Ryoya Tosaka (SelectaRank)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selectarank/daytona-x402.git"
  },
  "homepage": "https://github.com/selectarank/daytona-x402",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "tsx src/devServer.ts",
    "dev:mock-facilitator": "node src/mockFacilitator.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/express": "^2.27.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@x402/fetch": "^2.27.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "viem": "^2.57.0",
    "vitest": "^2.1.5"
  },
  "keywords": ["daytona", "x402", "agents", "payments", "sandbox", "usdc"]
}
